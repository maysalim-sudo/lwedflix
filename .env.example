# Copy to .env.local and fill in. Read by `next build` (scripts/build-server.mjs).

# TMDB — https://www.themoviedb.org/settings/api (the "API Read Access Token").
# Required. It's copied into the app at build time, so anyone with the
# installer can read it — use a read-only token.
NEXT_PUBLIC_TMDB_BASE_URL=https://api.themoviedb.org/3
TMDB_ACCESS_TOKEN=

# Supabase — https://supabase.com/dashboard → Project Settings → API.
# The schema is in supabase/migrations.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional: YouTube Data API key for trailer search.
YOUTUBE_API_KEY=
